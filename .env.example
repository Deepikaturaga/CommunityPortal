# Local development environment.
# Generated from the environment variables actually referenced in the code.
# Copy this file to .env and fill in values for your local setup.
# Do NOT commit .env to source control.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Async DSN for the application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME@localhost:5432/appdb
# Synchronous DSN used by Alembic migrations (psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://app:CHANGE_ME@localhost:5432/appdb

# ── Auth / Security ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_random_secret_key

# ── Session store (ElastiCache Redis) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_SESSION_PREFIX=session:

# Session cookie settings
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_MAX_AGE=3600
# Set to false locally (no HTTPS); must be true in deployed envs
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/

# Session signing secret — ≥32 bytes random in deployed envs (from Secrets Manager)
SESSION_SIGNING_SECRET=change-me-before-production-32b!

# Whether to set Secure on all cookies (mirrors SESSION_COOKIE_SECURE for middleware)
COOKIE_SECURE=false

# ── HTTPS / Proxy ─────────────────────────────────────────────────────────────
HTTPS_BEHIND_PROXY=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-Idempotency-Key

# ── Content Security Policy ───────────────────────────────────────────────────
CSP_POLICY=default-src 'none'; frame-ancestors 'none'; form-action 'none'

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ── EventBridge ───────────────────────────────────────────────────────────────
# Set EVENTS_ENABLED=false to skip EventBridge calls locally
EVENT_BUS_NAME=app-events-local
EVENTS_ENABLED=false

# ── Auth stub (integration tests only) ───────────────────────────────────────
AUTH_STUB_ENABLED=false
