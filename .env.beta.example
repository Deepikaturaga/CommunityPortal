# Beta (pre-production) environment.
# Same variables as .env.example with beta-appropriate placeholder values.
# Real secret values (DATABASE_URL, DATABASE_SYNC_URL, SECRET_KEY,
# SESSION_SIGNING_SECRET) are injected at ECS task launch time from
# AWS Secrets Manager — do NOT commit actual secrets to this file.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=beta

# ── Database ──────────────────────────────────────────────────────────────────
# Supplied via AWS Secrets Manager in deployed env; placeholder only
DATABASE_URL=postgresql+asyncpg://app:REPLACE_VIA_SECRETS_MANAGER@beta-aurora-cluster.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/appdb
DATABASE_SYNC_URL=postgresql+psycopg2://app:REPLACE_VIA_SECRETS_MANAGER@beta-aurora-cluster.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/appdb

# ── Auth / Security ───────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_VIA_SECRETS_MANAGER

# ── Session store (ElastiCache Redis — TLS) ───────────────────────────────────
REDIS_URL=rediss://beta-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_SESSION_PREFIX=session:

SESSION_COOKIE_NAME=sid
SESSION_COOKIE_MAX_AGE=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/

SESSION_SIGNING_SECRET=REPLACE_VIA_SECRETS_MANAGER
COOKIE_SECURE=true

# ── HTTPS / Proxy ─────────────────────────────────────────────────────────────
HTTPS_BEHIND_PROXY=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=https://beta.app.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-Idempotency-Key

# ── Content Security Policy ───────────────────────────────────────────────────
CSP_POLICY=default-src 'none'; frame-ancestors 'none'; form-action 'none'

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ── EventBridge ───────────────────────────────────────────────────────────────
EVENT_BUS_NAME=app-events-beta
EVENTS_ENABLED=true

# ── Auth stub (must be false in deployed envs) ────────────────────────────────
AUTH_STUB_ENABLED=false
